{
  "name": "poolpoker",
  "version": "1.0.0",
  "description": "PoolPoker (球霸扑克) - 台球抽牌/卡牌对战 Web 应用",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "start": "npm run build && tsx server/index.ts",
    "dev:backend": "tsx watch server/index.ts",
    "dev:frontend": "vite",
    "dev": "concurrently -k -p \"[{name}]\" -n \"Backend,Frontend\" -c \"yellow,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,vue,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "keywords": [
    "billiards",
    "cards",
    "socket.io",
    "game"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "canvas-confetti": "^1.9.4",
    "express": "^4.19.2",
    "js-yaml": "^4.1.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~5.4.5",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.12"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "iOS >= 12",
    "Chrome >= 60"
  ]
}
